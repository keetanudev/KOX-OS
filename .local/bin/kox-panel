# ---------------------------------------------------------------------------
# process helpers
# ---------------------------------------------------------------------------


def run(cmd, timeout=6):
    """Time-boxed subprocess -> (rc, stdout, stderr).

    rc == 124 means the command was killed: callers treat that as
    "couldn't confirm", never as success.
    """
    try:
        proc = subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout
        )
        return proc.returncode, proc.stdout, proc.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except OSError as exc:
        return 127, "", str(exc)


def notify(title, body):
    run(["notify-send", title, body], timeout=4)


def bar_height():
    """Read the bar height from the Waybar config so the panel stays flush
    under the bar even if its height changes later. KOX names the config
    config.jsonc; the bare `config` name is kept as a fallback."""
    for name in ("config.jsonc", "config"):
        try:
            with open(os.path.expanduser("~/.config/waybar/" + name)) as fh:
                match = re.search(r'"height"\s*:\s*(\d+)', fh.read())
            if match:
                return int(match.group(1))
        except OSError:
            continue
    return 24


def waybar_rect():
    """Live geometry of the Waybar layer surface (x, width) on the primary
    monitor, or None when it cannot be determined. The bar may be a centered
    notch rather than full width, so the panel aligns to the bar's right
    edge (where its widgets live) instead of the screen's right edge."""
    try:
        out = subprocess.run(["hyprctl", "layers", "-j"],
                             capture_output=True, text=True, timeout=5)
        layers = json.loads(out.stdout)
    except Exception:
        return None
    try:
        for mon in layers.values():
            for level in mon.get("levels", {}).values():
                for lay in level:
                    if lay.get("namespace") == "waybar":
                        return (int(lay.get("x", 0)), int(lay.get("w", 0)))
    except (AttributeError, TypeError, ValueError):
        return None
    return None


def nm_fields(line, expected):
    """Split an nmcli terse line into `expected` fields.

    nmcli escapes its own ':' separator as '\\:', so a naive split(':')
    corrupts any SSID containing a colon. Split on unescaped separators, then
    unescape.
    """
    fields, cur, i = [], "", 0
    while i < len(line):
        ch = line[i]
        if ch == "\\" and i + 1 < len(line):
            cur += line[i + 1]
            i += 2
            continue
        if ch == ":":
            fields.append(cur)
            cur = ""
        else:
            cur += ch
        i += 1
    fields.append(cur)
    while len(fields) < expected:
        fields.append("")
    return fields[:expected]


def human_minutes(raw):
    try:
        minutes = int(raw)
    except (TypeError, ValueError):
        return ""
    if minutes <= 0:
        return ""
    hours, mins = divmod(minutes, 60)
    return f"{mins}m left" if hours <= 0 else f"{hours}h {mins:02d}m left"


# ---------------------------------------------------------------------------
# data providers
# ---------------------------------------------------------------------------


class Bluetooth:
    """bluetoothctl wrapper, with tri-state probes and verified actions."""

    @staticmethod
    def powered():
        rc, out, _ = run(["bluetoothctl", "show"])
        if rc != 0:
            return None
        match = re.search(r"Powered:\s*(\w+)", out)
        return match.group(1) == "yes" if match else None

    @staticmethod
    def set_power(on):
        return run(["bluetoothctl", "power", "on" if on else "off"])[0] == 0

    @staticmethod
    def _devices(paired_only):
        args = ["bluetoothctl", "devices"] + (["Paired"] if paired_only else [])
        rc, out, _ = run(args)
        if rc != 0:
            return None  # couldn't tell
        found = []
        for line in out.splitlines():
            match = re.match(
                r"^Device\s+((?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2})\s*(.*)$", line
            )
            if match:
                found.append((match.group(1), match.group(2).strip() or match.group(1)))
        return found

    @staticmethod
    def paired():
        return Bluetooth._devices(True)

    @staticmethod
    def known():
        return Bluetooth._devices(False)

    @staticmethod
    def info(mac):
        rc, out, _ = run(["bluetoothctl", "info", mac])
        if rc == 124:
            return None
        if "not available" in out:
            return {}
        data = {}
        for key in ("Connected", "Paired", "Trusted", "Battery Percentage"):
            match = re.search(rf"{key}:\s*(\S+)", out)
            if match:
                data[key] = match.group(1)
        return data

    @staticmethod
    def connect(mac):
        return run(["bluetoothctl", "connect", mac], timeout=22)[0] == 0

    @staticmethod
    def disconnect(mac):
        return run(["bluetoothctl", "disconnect", mac])[0] == 0

    @staticmethod
    def pair(mac, name):
        if run(["bluetoothctl", "trust", mac])[0] != 0:
            return False, "Could not trust device"
        if run(["bluetoothctl", "pair", mac], timeout=22)[0] != 0:
            return False, "Pairing failed (device may need its agent)"
        run(["bluetoothctl", "connect", mac], timeout=22)
        return True, f"Paired {name}"

    @staticmethod
    def forget(mac):
        """Disconnect first (bluez refuses RemoveDevice with a live link, and
        speakers reconnect instantly), then verify the device really left the
        Paired list before reporting success."""
        for _ in range(8):
            if (Bluetooth.info(mac) or {}).get("Connected") != "yes":
                break
            run(["bluetoothctl", "disconnect", mac])
            time.sleep(0.5)
        detail = ""
        for _ in range(3):
            rc, out, _ = run(["bluetoothctl", "remove", mac], timeout=10)
            detail = "timed out" if rc == 124 else (out.strip().replace("\n", " ") or f"rc={rc}")
            paired = Bluetooth.paired()
            if paired is None:
                time.sleep(1)
                continue
            if not any(m.upper() == mac.upper() for m, _ in paired):
                return True, "Forgot device"
            run(["bluetoothctl", "disconnect", mac])
            time.sleep(1)
        return False, f"Could not forget device ({detail})"

    @staticmethod
    def scan(seconds=12):
        run(["bluetoothctl", "pairable", "on"])
        run(["bluetoothctl", "power", "on"])
        run(["bluetoothctl", "--timeout", str(seconds), "scan", "on"], timeout=seconds + 4)


class Wifi:
    """nmcli wrapper. Note: nmcli reports wifi connections as
    '802-11-wireless', never 'wifi' - matching on the wrong string is why
    saved networks used to look empty."""

    @staticmethod
    def radio_on():
        rc, out, _ = run(["nmcli", "radio", "wifi"])
        return out.strip().lower() == "enabled" if rc == 0 else None

    @staticmethod
    def set_radio(on):
        return run(["nmcli", "radio", "wifi", "on" if on else "off"])[0] == 0

    @staticmethod
    def device():
        """(name, state, ip4-without-mask) for the first wifi interface."""
        rc, out, _ = run(["nmcli", "-g", "GENERAL.DEVICE,GENERAL.STATE,IP4.ADDRESS", "dev", "show"])
        if rc != 0:
            return None
        for line in out.splitlines():
            name, state, addr = nm_fields(line, 3)
            if not re.match(r"^wl", name):
                continue
            return name, state, addr.split("/")[0]
        return None

    @staticmethod
    def active_ssid():
        dev = Wifi.device()
        if not dev:
            return None
        rc, out, _ = run(["nmcli", "-g", "GENERAL.CONNECTION", "dev", "show", dev[0]])
        return out.strip() or None if rc == 0 else None

    @staticmethod
    def saved():
        """Saved wifi profiles -> [(ssid, device-or-empty)]."""
        rc, out, _ = run(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "con", "show"])
        if rc != 0:
            return None
        found = []
        for line in out.splitlines():
            name, ctype, device = nm_fields(line, 3)
            if name and ctype in ("802-11-wireless", "wifi"):
                found.append((name, device))
        return found

    @staticmethod
    def scan_list(rescan=False):
        args = ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"]
        if not rescan:
            args += ["--rescan", "no"]
        rc, out, _ = run(args, timeout=25 if rescan else 8)
        if rc != 0:
            return None
        seen, nets = set(), []
        for line in out.splitlines():
            inuse, ssid, signal, security = nm_fields(line, 4)
            ssid = ssid.strip()
            if not ssid or ssid in seen:
                continue
            seen.add(ssid)
            nets.append(
                {
                    "ssid": ssid,
                    "in_use": inuse.strip() == "*",
                    "signal": int(signal) if signal.strip().isdigit() else 0,
                    "security": security.strip(),
                }
            )
        nets.sort(key=lambda n: (not n["in_use"], -n["signal"]))
        return nets

    @staticmethod
    def has_profile(ssid):
        """True if a saved Wi-Fi connection profile already exists for this
        network. NetworkManager names a profile after the SSID when the network
        is first joined, so match on NAME (only `con show` exposes that)."""
        rc, out, _ = run(["nmcli", "-t", "-f", "NAME,TYPE", "con", "show"], timeout=8)
        if rc != 0:
            return False
        for line in out.splitlines():
            name, ctype = nm_fields(line, 2)
            if name.strip() == ssid and ctype.strip() in ("802-11-wireless", "wifi"):
                return True
        return False

    @staticmethod
    def connect(ssid, password=None):
        """-> (ok, message, needs_password)

        A network that has never been joined has no connection profile yet, so
        `nmcli con up id <ssid>` fails with "unknown connection". Ask
        NetworkManager to connect to the SSID itself instead: that creates the
        profile, joins open networks right away, and reports back that a
        password is required for secured ones.
        """
        if password is not None:
            cmd = ["nmcli", "dev", "wifi", "connect", ssid, "password", password]
        elif Wifi.has_profile(ssid):
            cmd = ["nmcli", "con", "up", "id", ssid]
        else:
            cmd = ["nmcli", "dev", "wifi", "connect", ssid]
        rc, out, err = run(cmd, timeout=30)
        blob = f"{out}\n{err}"
        if rc != 0 and "unknown connection" in blob.lower():
            # The profile was gone between the lookup and the call: connect by
            # network name instead of profile name.
            rc, out, err = run(["nmcli", "dev", "wifi", "connect", ssid], timeout=30)
            blob = f"{out}\n{err}"
        if rc == 0:
            return True, f"Connected to {ssid}", False
        low = blob.lower()
        if (
            "secrets were required" in low
            or "passwords or encryption keys are required" in low
            or "password for" in low
        ):
            return False, "", True
        first = (err or "").strip().splitlines()
        return False, f"Failed: {first[0] if first else 'unknown error'}", False

    @staticmethod
    def disconnect():
        # BUGFIX (KOX): the rice called bare `nmcli con down`, which always
        # fails with "Error: No connection specified." - the panel's
        # Disconnect button never worked. Disconnect the Wi-Fi device itself:
        # scoped to the wifi interface only, so a wired uplink (usb0) can
        # never be torn down by accident.
        dev = Wifi.device()
        if not dev:
            return False
        return run(["nmcli", "device", "disconnect", dev[0]])[0] == 0

    @staticmethod
    def forget(ssid):
        return run(["nmcli", "con", "delete", "id", ssid], timeout=12)[0] == 0

    @staticmethod
    def link_details():
        """Live link facts for the Wi-Fi device -> dict or None.

        dns/con drive the DNS section and the header; `con` is the
        active profile name ("" when connected to nothing)."""
        dev = Wifi.device()
        if not dev:
            return None
        name, _state, ip = dev
        con = Wifi.active_ssid() or ""
        gw = ""
        rc, out, _ = run(["ip", "-4", "route", "show", "default", "dev", name], timeout=5)
        if rc == 0:
            match = re.search(r"default via (\S+)", out)
            gw = match.group(1) if match else ""
        dns = []
        rc, out, _ = run(["nmcli", "-g", "IP4.DNS", "dev", "show", name], timeout=5)
        if rc == 0:
            dns = [
                t.strip()
                for t in out.splitlines()
                if re.match(r"^\d+\.\d+\.\d+\.\d+$", t.strip())
            ]
        ignore = False
        if con:
            rc, out, _ = run(
                ["nmcli", "-g", "ipv4.ignore-auto-dns", "con", "show", con], timeout=5
            )
            ignore = rc == 0 and out.strip().lower() == "yes"
        return {"dev": name, "ip": ip, "gw": gw, "dns": dns, "con": con, "ignore": ignore}

    @staticmethod
    def set_dns(con, ips):
        """Point the profile at explicit resolvers (ips=[] resets to DHCP).
        `nmcli device reapply` applies DNS live, without dropping the link."""
        if not con:
            return False
        cmd = ["nmcli", "con", "mod", con, "ipv4.ignore-auto-dns", "no" if not ips else "yes"]
        cmd += ["ipv4.dns", " ".join(ips)]
        ok = run(cmd, timeout=10)[0] == 0
        dev = Wifi.device()
        if ok and dev:
            run(["nmcli", "device", "reapply", dev[0]], timeout=15)
        return ok


class Power:
    @staticmethod
    def battery():
        """-> (percent, status, time_remaining_minutes) or None."""
        try:
            supplies = sorted(os.listdir("/sys/class/power_supply"))
        except OSError:
            return None
        for base in supplies:
            if not base.startswith("BAT"):
                continue
            path = os.path.join("/sys/class/power_supply", base)

            def read(name, default=""):
                try:
                    with open(os.path.join(path, name)) as fh:
                        return fh.read().strip()
                except OSError:
                    return default

            raw = read("capacity", "-1")
            if not raw.lstrip("-").isdigit() or int(raw) < 0:
                continue
            left = read("time_to_empty_now") or read("time_to_full_now")
            # Clamp: some drivers over-report (this BAT1 reports 101 on AC).
            return min(int(raw), 100), read("status", "Unknown"), left
        return None

    @staticmethod
    def profile():
        rc, out, _ = run(["powerprofilesctl", "get"])
        return out.strip() if rc == 0 and out.strip() else None

    @staticmethod
    def set_profile(name):
        rc, _, err = run(["powerprofilesctl", "set", name], timeout=10)
        detail = (err or "").strip().splitlines()
        return rc == 0, (detail[0] if detail else "")

    @staticmethod
    def brightness():
        try:
            names = sorted(os.listdir("/sys/class/backlight"))
        except OSError:
            return None
        for name in names:
            try:
                with open(f"/sys/class/backlight/{name}/brightness") as fh:
                    current = int(fh.read().strip())
                with open(f"/sys/class/backlight/{name}/max_brightness") as fh:
                    maximum = int(fh.read().strip())
            except (OSError, ValueError):
                continue
            if maximum > 0:
                return max(1, min(100, round(current * 100 / maximum)))
        return None

    @staticmethod
    def set_brightness(percent):
        value = max(1, min(100, int(percent)))
        return run(["brightnessctl", "set", f"{value}%"], timeout=8)[0] == 0

    @staticmethod
    def volume():
        rc, out, _ = run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        if rc != 0:
            return None
        match = re.search(r"([\d.]+)", out)
        if not match:
            return None
        return int(round(float(match.group(1)) * 100)), "MUTED" in out.upper()

    @staticmethod
    def set_volume(percent):
        value = max(0, min(100, int(percent)))
        return run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{value}%"], timeout=8)[0] == 0


# ---------------------------------------------------------------------------
# single instance: same button closes, different button swaps
# ---------------------------------------------------------------------------


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


class SingleInstance:
    def __init__(self, mode):
        self.mode = mode
        runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
        self.lock_path = os.path.join(runtime, "kox-panel.lock")
        self.state_path = self.lock_path + ".state"
        self.handle = None

    def acquire(self):
        """True -> show the panel. False -> the click closed an open panel."""
        deadline = time.time() + 3.0
        while time.time() < deadline:
            handle = open(self.lock_path, "a+")
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                pid, mode = self._read_state()
                if pid and pid_alive(pid):
                    same = mode == self.mode
                    self._terminate(pid)
                    handle.close()
                    if same:
                        return False  # same bar button: toggle closed
                    time.sleep(0.15)
                    continue
                handle.close()  # owner vanished: retry
                time.sleep(0.1)
                continue
            handle.seek(0)
            handle.truncate()
            handle.write(f"{os.getpid()} {self.mode}\n")
            handle.flush()
            self.handle = handle
            # The pid/mode must ALSO go to their own file: flock tells us that
            # *someone* holds the lock but not which pid or which panel, and
            # without this the "click the same button again to close" toggle
            # can never identify its target.
            self._write_state()
            return True
        return False

    def _read_state(self):
        try:
            with open(self.state_path) as fh:
                pid, mode = fh.read().split()[:2]
            return int(pid), mode
        except (OSError, ValueError, IndexError):
            return 0, ""

    def _write_state(self):
        with open(self.state_path, "w") as fh:
            fh.write(f"{os.getpid()} {self.mode}\n")

    @staticmethod
    def _terminate(pid, grace=1.2):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            return
        end = time.time() + grace
        while time.time() < end and pid_alive(pid):
            time.sleep(0.05)
        if pid_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass

    def release(self):
        if self.handle:
            try:
                fcntl.flock(self.handle, fcntl.LOCK_UN)
                self.handle.close()
            except OSError:
                pass
            self.handle = None


