#!/usr/bin/env python3
"""kox-panel - Omarchy-style dropdown panels for the Waybar status bar.

Modes:
    kox-panel bluetooth    power switch, paired devices, scan/pair
    kox-panel wifi          power switch, known networks, scan/join
    kox-panel battery       charge state, power profiles, brightness, volume

The panel is anchored under the top bar on the right (like the Omarchy
menus) instead of a centred fuzzy popup. The bar buttons
(~/.local/bin/cachy-bluetooth, cachy-wifi, cachy-power) are thin wrappers
around this, so the Waybar config needs no changes.

Design notes - each of these is a bug this panel was written to avoid:
  * Every shell-out is time-boxed: bluetoothctl/nmcli have been seen to block
    forever, and a frozen panel is worse than an error message.
  * State is verified after an action instead of trusting an exit code, and an
    inconclusive check reports "couldn't confirm" rather than a false success.
  * Regions are created once and only refilled when their content signature
    changes, so rows never flicker, duplicate, or rebuild under the pointer.
  * An open Wi-Fi password prompt is never rebuilt away.
  * Only one panel exists at a time: clicking the same bar button again closes
    it, clicking a different one swaps panels.
  * The fuzzy CLI equivalents (cachy-*-cli) remain as a fallback.
"""

import fcntl
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time

MODES = ("bluetooth", "wifi", "battery")
SOCKET_ENV = "KOX_PANEL_SOCKET"


def socket_path():
    override = os.environ.get(SOCKET_ENV)
    if override:
        return override
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    return os.path.join(runtime, "kox-panel.sock")


def read_cursorpos():
    """(x, y) of the pointer, or None.

    Run at helper start, BEFORE any GTK import: waybar forks this process
    the instant an icon is pressed, so the freshest available snapshot of
    the click is what anchors the panel below the icon. Read straight from
    Hyprland's IPC socket - forking hyprctl costs ~30ms more, and every
    millisecond here is a millisecond the user has to sweep the mouse off
    the icon before the snapshot lands."""
    try:
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if sig:
            path = os.path.join(
                os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
                "hypr", sig, ".socket.sock")
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(2)
                s.connect(path)
                s.sendall(b"cursorpos")
                out = s.recv(128).decode(errors="replace")
            x, y = (int(v) for v in out.replace(",", " ").split()[:2])
            return (x, y)
    except Exception:
        pass
    try:
        out = subprocess.run(["hyprctl", "cursorpos"], capture_output=True,
                             text=True, timeout=2).stdout
        x, y = (int(v) for v in out.replace(",", " ").split()[:2])
        return (x, y)
    except Exception:
        return None


def bar_anchor(click_pos):
    """Screen x to anchor under when click_pos is a click on or near the
    bar, else None.

    The strip is the bar's height PLUS a generous slop: the snapshot is
    taken ~25ms after the press and a quick flick already slides the
    pointer below the bar in that time - its x still sits under the icon,
    which is exactly where the panel belongs. Anything further away (a
    keybind, a cursor parked mid-screen) keeps the wider fallback in
    place(), which anchors to the bar's centre."""
    if not click_pos:
        return None
    try:
        if click_pos[1] <= bar_height() + 64:
            return click_pos[0]
    except Exception:
        pass
    return None


def request_panel(mode, click_pos=None):
    """Ask a running daemon to show `mode`. True when a daemon took it.

    Returns False when there is no daemon (socket missing, refused or the
    daemon died), and the caller then builds the panel the slow way. The
    click position rides along so the daemon can anchor under the icon."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(1.5)
            sock.connect(socket_path())
            payload = mode
            if click_pos:
                payload += " %d %d" % click_pos
            sock.sendall((payload + "\n").encode())
        return True
    except OSError:
        return False


# Fast path, evaluated BEFORE the gi/GTK import below. A bar click the daemon
# can serve must not pay ~250ms of interpreter + PyGObject startup just to
# write five bytes to a socket: importing gi is by far the most expensive
# thing this script does, and the click path needs none of it. This is not on
# the user's critical path (waybar spawns on-click handlers asynchronously),
# but it keeps the helper from lingering and leaves the CPU free for the
# frame that is being drawn.
_click_pos = None
if __name__ == "__main__" and len(sys.argv) > 1:
    _argv = sys.argv[1:]
    if _argv[0] in MODES and "--daemon" not in _argv and "-d" not in _argv:
        # Snapshot the click position first (see read_cursorpos): this is
        # the icon's location, captured before the mouse can have moved on.
        _click_pos = read_cursorpos()
        if request_panel(_argv[0], _click_pos):
            sys.exit(0)

# A panel is a GUI: with no Wayland display there is nothing to show, and the
# CLI fallbacks exist for that case.
if not os.environ.get("WAYLAND_DISPLAY"):
    sys.exit(1)

try:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    gi.require_version("Pango", "1.0")
    from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, Pango
except Exception as exc:  # missing gi, Pango, or layer-shell support
    sys.stderr.write(f"kox-panel: GTK/LayerShell unavailable ({exc})\n")
    sys.exit(1)

if not GtkLayerShell.is_supported():
    sys.stderr.write("kox-panel: gtk-layer-shell is not supported by this session\n")
    sys.exit(1)

APP = "kox-panel"
ACCENT = "#ff79c6"
PANEL_WIDTH = 350
GAP = 10
DOT = "\u00b7"  # middle dot, matches the reference panel typography

