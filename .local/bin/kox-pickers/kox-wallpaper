#!/usr/bin/env bash
# kox-wallpaper: KOX OS visual wallpaper selector.
# Ported from the rice's cachy-wallpaper, with the KOX stack enforced:
#   - applies via Hyprpaper (Agents.md mandate — NEVER swaybg/swww)
#   - no systemd: hyprpaper is a plain process (re)started directly
#
# Sources: ~/Pictures/Wallpapers only (user collection, KOX-minimal).
# Applies instantly by rewriting `path = ...` in ~/.config/hypr/hyprpaper.conf
# (hyprpaper 0.8.5 schema: wallpaper { monitor = *; path; fit_mode }) and
# restarting the hyprpaper process; persists the choice for --restore.
# Picker: fullscreen coverflow with live thumbnails + color-filter dots when
# quickshell is installed, else fuzzel with thumbnail icons.
#
# Preview/thumbnail backend: ffmpeg (ImageMagick is not installed on KOX;
# ffmpeg's scale/crop chain and 1x1 rawvideo probe cover both needs).
# If ffmpeg is absent the picker degrades gracefully: full-res paths go
# straight to the QML (it scales itself) and the color dots are hidden.
#
# Usage: kox-wallpaper [--restore]
set -u

STATE_DIR="$HOME/.config/kox/pickers"
STATE="$STATE_DIR/wallpaper"
CONF="$HOME/.config/hypr/hyprpaper.conf"
WALL_DIR="$HOME/Pictures/Wallpapers"
CACHE="$HOME/.cache/kox/pickers"
COVERFLOW="$HOME/.local/bin/kox-pickers/kox-coverflow"
HAVE_FFMPEG=0
command -v ffmpeg >/dev/null 2>&1 && HAVE_FFMPEG=1

mkdir -p "$STATE_DIR" "$WALL_DIR" "$CACHE"/wallpapers "$CACHE"/buckets

# Hex color of one entry → picker color bucket (pure stdlib python, same
# HLS thresholds as the rice's cachy-color-bucket).
bucket_hex() {
  python3 - "$1" <<'EOF'
import colorsys, sys
h = sys.argv[1].lstrip('#')
try:
    r, g, b = (int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))
except (ValueError, IndexError):
    print("gray"); sys.exit(0)
hh, ll, ss = colorsys.rgb_to_hls(r, g, b)
deg = hh * 360.0
if ss < 0.16 or ll < 0.12:
    print("gray")
elif deg < 12 or deg >= 345:
    print("red")
elif deg < 40:
    print("orange")
elif deg < 68:
    print("yellow")
elif deg < 168:
    print("green")
elif deg < 258:
    print("blue")
elif deg < 292:
    print("purple")
else:
    print("pink")
EOF
}

# Dominant color of an image → bucket name, cached by path+mtime+size.
bucket_image() {
  local img="$1"
  local key hit px
  key="$(printf '%s' "$img" | sha1sum | cut -c1-12).$(stat -c '%Y-%s' "$img" 2>/dev/null | tr -dc '0-9')"
  hit="$CACHE/buckets/$key"
  if [[ -f "$hit" ]]; then cat "$hit"; return 0; fi
  # 1x1 rawvideo rgb24 = 3 bytes on stdout → hex → HLS bucket
  px="$(ffmpeg -loglevel error -i "$img" -vf "scale=1:1" -frames:v 1 \
        -f rawvideo -pix_fmt rgb24 - 2>/dev/null | od -An -tx1 | tr -d ' \n')" || px=""
  [[ "$px" =~ ^[0-9a-fA-F]{6}$ ]] || px="808080"
  local out; out="$(bucket_hex "#$px")"
  printf '%s\n' "$out" | tee "$hit"
}

# Thumbnail: 480x270 center fill-crop (rice equivalent), cached by sha1.
thumb() {
  local src="$1"
  local dst="$CACHE/wallpapers/$(printf '%s' "$src" | sha1sum | cut -c1-12).jpg"
  if [[ -f "$dst" && "$dst" -nt "$src" ]]; then printf '%s\n' "$dst"; return 0; fi
  ffmpeg -y -loglevel error -i "$src" \
    -vf "scale=480:270:force_original_aspect_ratio=increase,crop=480:270" \
    -frames:v 1 -qscale:v 3 "$dst" 2>/dev/null || return 1
  printf '%s\n' "$dst"
}

apply() { # $1 = image path
  local img="$1"
  [[ -r "$img" ]] || return 1
  # Idempotence: this image already owns both state and conf on a live
  # daemon → skip the kill/restart cycle (no flicker on repeated applies,
  # e.g. re-selecting the current theme).
  if [[ "$(cat "$STATE" 2>/dev/null)" == "$img" ]] \
     && grep -Fq "path = $img" "$CONF" 2>/dev/null \
     && pgrep -x hyprpaper >/dev/null 2>&1; then
    return 0
  fi
  # Escape sed metacharacters so odd filenames can never corrupt the conf.
  local esc="${img//\\/\\\\}"; esc="${esc//&/\\&}"; esc="${esc//|/\\|}"
  if [[ -f "$CONF" ]] && grep -qE '^[[:space:]]*path[[:space:]]*=' "$CONF"; then
    sed -i -E "s|^([[:space:]]*path[[:space:]]*=[[:space:]]*).*|\1$esc|" "$CONF"
  elif [[ -f "$CONF" ]]; then
    # Conf exists but has no wallpaper block (e.g. splash-only) — append one.
    printf '\nwallpaper {\n    monitor = *\n    path = %s\n    fit_mode = cover\n}\n' "$img" >> "$CONF"
  else
    # Missing conf: write the full hyprpaper 0.8.5 default schema.
    mkdir -p "$(dirname "$CONF")"
    printf '# KOX OS — Hyprpaper (generated by kox-wallpaper)\nsplash = false\n\nwallpaper {\n    monitor = *\n    path = %s\n    fit_mode = cover\n}\n' "$img" > "$CONF"
  fi
  # Restart hyprpaper as a plain process (OpenRC session, no systemd).
  killall hyprpaper 2>/dev/null || pkill -x hyprpaper 2>/dev/null || true
  sleep 0.3
  if command -v hyprpaper >/dev/null 2>&1; then
    nohup hyprpaper >/dev/null 2>&1 &
    disown
  else
    notify-send "Wallpaper" "hyprpaper not installed; conf updated" 2>/dev/null || true
  fi
  printf '%s\n' "$img" > "$STATE"
  notify-send "Wallpaper" "$(basename "$img")" 2>/dev/null || true
}

if [[ "${1:-}" == "--restore" ]]; then
  SAVED="$(cat "$STATE" 2>/dev/null || true)"
  if [[ -r "$SAVED" ]]; then
    apply "$SAVED"
  else
    notify-send "Wallpaper" "No saved wallpaper found" 2>/dev/null || true
  fi
  exit 0
fi

if [[ "${1:-}" == "--set" ]]; then
  # Internal apply hook (used by kox-theme): set a specific image directly.
  if apply "${2:-}"; then
    exit 0
  fi
  notify-send "Wallpaper" "Cannot apply: ${2:-<no path given>}" 2>/dev/null || true
  exit 1
fi

# Collect the user collection with a live thumbnail per entry.
LABELS=(); PATHS=(); IMAGES=()
while IFS= read -r f; do
  img="$f"
  if (( HAVE_FFMPEG )); then
    t="$(thumb "$f")" && img="$t"
  fi
  LABELS+=("$(basename "$f")"); PATHS+=("$f"); IMAGES+=("$img")
done < <(find "$WALL_DIR" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort)
[[ ${#LABELS[@]} -eq 0 ]] && { notify-send "Wallpaper" "No images found in $WALL_DIR" 2>/dev/null || true; exit 1; }

CURRENT="$(cat "$STATE" 2>/dev/null)"
INIT=0
for i in "${!PATHS[@]}"; do [[ "${PATHS[$i]}" == "$CURRENT" ]] && { INIT=$i; break; }; done

if command -v quickshell >/dev/null 2>&1; then
  ACCENT="$(grep -oE '#[0-9a-fA-F]{6}' "$HOME/.config/waybar/theme-accent.css" 2>/dev/null | head -1)"
  [[ "$ACCENT" =~ ^#[0-9a-fA-F]{6}$ ]] || ACCENT="#7dcfff"
  CF=0
  (( HAVE_FFMPEG )) && CF=1   # color dots need the ffmpeg dominant-color probe
  JSON="$(for i in "${!LABELS[@]}"; do
    if (( CF )); then B="$(bucket_image "${PATHS[$i]}")"; else B=""; fi
    printf '%s\t%s\t%s\n' "${LABELS[$i]}" "${IMAGES[$i]}" "$B"
  done |
    python3 -c 'import sys,json; print(json.dumps([{"label":l,"image":p,"bucket":b} for l,p,b in (ln.rstrip("\n").split("\t") for ln in sys.stdin)]))')"
  if IDX="$(KOX_CF_COLORFILTER=$CF KOX_CF_ACCENT="$ACCENT" "$COVERFLOW" 'Wallpaper' "$INIT" "$JSON")"; then
    [[ "$IDX" =~ ^[0-9]+$ ]] && (( IDX < ${#PATHS[@]} )) && {
      apply "${PATHS[$IDX]}"
      exit 0
    }
  else
    CF_STATUS=$?
    (( CF_STATUS == 2 )) && exit 0
  fi
  # Quickshell installed but the QML run failed: fall through to fuzzel
  # instead of silently doing nothing (same ladder as the old picker).
fi

# Fallback: fuzzel with thumbnail icons (Rofi extended dmenu protocol:
# "<display>\0icon\x1f<thumb>"). Python emits the NUL bytes — bash
# variables cannot hold them. Display carries the basename; it maps back
# exactly via LABELS (basenames are unique inside one directory).
CHOICE="$(for i in "${!LABELS[@]}"; do
  if [[ "${PATHS[$i]}" == "$CURRENT" ]]; then
    printf '* %s (active)\t%s\n' "${LABELS[$i]}" "${IMAGES[$i]}"
  else
    printf '%s\t%s\n' "${LABELS[$i]}" "${IMAGES[$i]}"
  fi
done | python3 -c 'import sys; [sys.stdout.buffer.write((p[0] + "\0icon\x1f" + p[1] + "\n").encode()) for ln in sys.stdin for p in [ln.rstrip("\n").split("\t")]]' |
  fuzzel --dmenu --prompt 'Wallpaper: ')" || exit 0
NAME="$(printf '%s' "$CHOICE" | sed -E 's/^(\* |  )//; s/ \(active\)$//')"
for i in "${!LABELS[@]}"; do
  [[ "${LABELS[$i]}" == "$NAME" ]] && { apply "${PATHS[$i]}"; break; }
done
