#!/usr/bin/env bash
# cachy-screenrecord-status: Waybar "custom/recording" indicator (JSON).
# Prints nothing while idle, which makes Waybar hide the module entirely.
set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/cachy-screenrecord"
PIDFILE="$STATE_DIR/pid"

[[ -r "$PIDFILE" ]] || exit 0
read -r pid <"$PIDFILE" || exit 0
[[ "$pid" =~ ^[0-9]+$ ]] || exit 0
kill -0 "$pid" 2>/dev/null || exit 0

start="$(cat "$STATE_DIR/start" 2>/dev/null || true)"
if [[ ! "$start" =~ ^[0-9]+$ ]]; then
  start="$(date +%s)"
fi

elapsed=$(( $(date +%s) - start ))
if (( elapsed < 0 )); then
  elapsed=0
fi

if (( elapsed >= 3600 )); then
  text="● $(printf '%d:%02d:%02d' $((elapsed / 3600)) $(((elapsed % 3600) / 60)) $((elapsed % 60)))"
else
  text="● $(printf '%d:%02d' $((elapsed / 60)) $((elapsed % 60)))"
fi

file="$(cat "$STATE_DIR/file" 2>/dev/null || true)"
tooltip="Recording"
if [[ -n "$file" ]]; then
  tooltip="Recording to $file"
fi
tooltip+=$'\nClick or press Alt+Print to stop'

jq -cn --arg text "$text" --arg tooltip "$tooltip" \
  '{ text: $text, tooltip: $tooltip, class: "recording", alt: "recording" }'
