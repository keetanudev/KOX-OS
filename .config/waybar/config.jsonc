// KOX OS — ultra-thin bar
// custom/{wifi,battery} poll at 5 s per the owner's explicit request
// (2026-11-11); everything else is native/event-driven.
//
// Bluetooth lockstep: kox-bt-watcher (autostart) polls the BT state, writes
// $XDG_RUNTIME_DIR/kox-bt-state.json once per change and signals waybar
// ("signal": 8 → SIGRTMIN+8). Both BT widgets then re-render at the same
// instant from that file, so no desync ever nudges the notch; the 5 s
// interval stays as a startup/fallback poll.
{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [],
    "modules-center": ["hyprland/workspaces", "clock", "custom/wifi", "custom/bluetooth", "pulseaudio", "custom/battery", "custom/power"],
    "modules-right": [],

    "hyprland/workspaces": {},

    "clock": {
        "format": "{:%H:%M}"
    },

    "custom/wifi": {
        "exec": "~/.local/bin/kox-widgets/kox-wifi",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.local/bin/kox-panel wifi",
        "on-click-right": "~/.local/bin/kox-widgets/kox-wifi toggle",
        "tooltip": true
    },

    "custom/bluetooth": {
        "exec": "cat /run/user/1000/kox-bt-state.json",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "~/.local/bin/kox-panel bluetooth",
        "on-click-right": "~/.local/bin/kox-widgets/kox-bluetooth toggle",
        "tooltip": true
    },

    "custom/battery": {
        "exec": "~/.local/bin/kox-widgets/kox-power",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.local/bin/kox-panel battery",
        "tooltip": true
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": "󰕾"
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "custom/power": {
        "format": "",
        "on-click": "~/.local/bin/cachy-powermenu"
    }
}
